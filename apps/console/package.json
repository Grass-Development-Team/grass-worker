{
  "name": "@grass-worker/console",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test --project=chromium",
    "test:e2e": "playwright test",
    "test:install": "playwright install chromium firefox webkit",
    "screenshots": "bun run tests/screenshots/capture.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lit/context": "^1.1.6",
    "@tanstack/query-core": "^5.101.2",
    "lit": "^3.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.0.0",
    "prettier": "^3.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
