[server]
host = "127.0.0.1"
port = 7817

[database]
url = "postgres://postgres:postgres@127.0.0.1:5432/grass_worker"

[redis]
url = "redis://127.0.0.1:6379/0"

[storage]
root = "/data"

[secrets]
secret_key = "change-me"

# Private Git credentials use a separate 32-byte AEAD master key. Prefer the
# GWAPI_GIT_CREDENTIAL_MASTER_KEY and GWAPI_GIT_CREDENTIAL_KEY_ID environment
# variables. To configure a keyring in TOML instead, uncomment and replace:
# [secrets.git_credentials]
# active_key_id = "primary"
# [secrets.git_credentials.keys]
# primary = "BASE64URL_ENCODED_32_BYTE_KEY"

[session]
cookie_secure = false
idle_ttl_seconds = 900
session_ttl_seconds = 2592000

# Development mode permits trusted local HTTP by omitting Secure from auth
# cookies and bypassing CSRF checks for authenticated mutations. Never enable
# it on a publicly reachable deployment.
[development]
enabled = false

[audit]
# Audit events are retained for 90 days by default. Set to 0 to keep them
# permanently.
retention_days = 90

[mail]
# Outbound email is optional. Use "local" for a sendmail-compatible MTA or
# "smtp" for a remote SMTP server.
mode = "none"
from_address = "noreply@localhost"
from_name = "Grass Worker"
sendmail_command = "/usr/sbin/sendmail"
smtp_host = ""
smtp_port = 587
smtp_security = "starttls"
smtp_username = ""
# Prefer GWAPI_MAIL_SMTP_PASSWORD instead of storing this value in the file.
smtp_password = ""

[node_manager]
auto_start_local_node = false
local_node_binary = "grass-node"
local_node_config = "./node.toml"
restart_on_exit = true

[migration]
auto_migrate = false

[log]
level = "info"
format = "pretty"
